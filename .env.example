# MoySklad API token (Bearer)
MOYSKLAD_TOKEN=

# Organization UUID from MoySklad (GET /entity/organization)
# If empty or invalid, app uses the first non-archived organization.
MOYSKLAD_ORGANIZATION_ID=

# Three warehouse (store) UUIDs — GET /entity/store
# Must be real warehouse IDs from MoySklad (404 IDs → остатки будут 0).
# If empty or invalid, app rematches by STORE_*_NAME then fills from MoySklad.
MOYSKLAD_STORE_1_ID=
MOYSKLAD_STORE_2_ID=
MOYSKLAD_STORE_3_ID=

# Public store info (optional overrides; names default from MoySklad)
STORE_1_NAME=
STORE_1_ADDRESS=г. Дзержинск
STORE_1_HOURS=Ежедневно 10:00–22:00
STORE_1_PHONE=

STORE_2_NAME=
STORE_2_ADDRESS=г. Дзержинск
STORE_2_HOURS=Ежедневно 10:00–22:00
STORE_2_PHONE=

STORE_3_NAME=
STORE_3_ADDRESS=г. Дзержинск
STORE_3_HOURS=Ежедневно 10:00–22:00
STORE_3_PHONE=
